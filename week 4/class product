
class Product {

    private String code;
    private String name;
    private double unitPrice;
    private int quantity;
    private static int productCount = 0;

    Product(String code, String name, double unitPrice) {
        this(code, name, unitPrice, 0);
    }

    Product(String code, String name, double unitPrice, int quantity) {

        if (unitPrice <= 0) {
            throw new IllegalArgumentException("Price must be positive");
        }

        if (quantity < 0) {
            throw new IllegalArgumentException("Quantity cannot be negative");
        }

        this.code = code;
        this.name = name;
        this.unitPrice = unitPrice;
        this.quantity = quantity;

        productCount++;
    }

    void restock(int amount) {
        if (amount > 0) {
            quantity = quantity + amount;
        }
    }

    boolean sell(int amount) {
        if (amount > 0 && amount <= quantity) {
            quantity = quantity - amount;
            return true;
        }

        return false;
    }

    double getInventoryValue() {
        return unitPrice * quantity;
    }

    static int getProductCount() {
        return productCount;
    }

    public String toString() {
        return "Product Code: " + code +
               ", Name: " + name +
               ", Price: " + unitPrice +
               ", Quantity: " + quantity +
               ", Inventory Value: " + getInventoryValue();
    }
}

public class ProductInventory {

    public static void main(String[] args) {

        Product product1 = new Product("P101", "Laptop", 50000);
        Product product2 = new Product("P102", "Mouse", 500, 10);
        Product product3 = new Product("P103", "Keyboard", 1000, 5);

        System.out.println(product1);
        System.out.println(product2);
        System.out.println(product3);

        product1.restock(2);
        product2.sell(3);
        product3.sell(2);

        System.out.println();

        System.out.println(product1);
        System.out.println(product2);
        System.out.println(product3);

        System.out.println();

        System.out.println("Trying to sell unavailable quantity: " + product3.sell(10));

        System.out.println("Total Products Created: " + Product.getProductCount());
    }
}

